# AgroIntel AI — variáveis de ambiente
#
# NÃO coloque valores reais neste arquivo. Ele é só um modelo.
#
# - O arquivo ".env" (gerenciado pelo Lovable) guarda apenas dados PÚBLICOS do
#   Supabase: a URL e a chave "publishable/anon", que podem ir ao navegador.
# - Os SEGREDOS abaixo ficam apenas no painel de variáveis/secrets do ambiente
#   onde o app roda (Lovable Cloud → Secrets). Nunca comite segredos no GitHub.

# ── Públicas (já presentes no .env gerenciado pelo Lovable) ──────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# ── Segredos (somente no servidor) ───────────────────────────────────────────
# Chave de serviço do Supabase: acesso total ao banco. Usada só em rotinas do servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Consultor IA (Lovable AI Gateway)
LOVABLE_API_KEY=

# Cobrança (Asaas) — ver docs/BILLING.md
BILLING_PROVIDER=asaas
# "sandbox" = testes sem cobrança real. Qualquer outro valor desliga a cobrança.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Token forte (32+ caracteres), o mesmo cadastrado no webhook do Asaas.
ASAAS_WEBHOOK_TOKEN=

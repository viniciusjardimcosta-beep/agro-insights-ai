# AgroIntel AI — variáveis de ambiente
#
# NÃO coloque valores reais neste arquivo. Ele é só um modelo.
#
# - O arquivo ".env" (gerenciado pelo Lovable) guarda apenas dados PÚBLICOS do
#   Supabase: a URL e a chave "publishable/anon", que podem ir ao navegador.
# - Os SEGREDOS abaixo ficam apenas no painel de variáveis/secrets do ambiente
#   onde o app roda (Lovable Cloud → Secrets). Nunca comite segredos no GitHub.

# ── Públicas (já presentes no .env gerenciado pelo Lovable) ──────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# ── Segredos (somente no servidor) ───────────────────────────────────────────
# Chave de serviço do Supabase: acesso total ao banco. Usada só em rotinas do servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Consultor IA (Lovable AI Gateway)
LOVABLE_API_KEY=

# Cobrança (Stripe) — ver docs/BILLING.md
BILLING_PROVIDER=stripe
# "test" = modo de teste, sem cobrança real. Qualquer outro valor desliga a cobrança.
STRIPE_ENVIRONMENT=test
# Chave secreta de TESTE (sk_test_… ou rk_test_…). Chaves sk_live_ são recusadas.
STRIPE_SECRET_KEY=
# Segredo de assinatura do webhook (whsec_…), gerado ao criar o endpoint no Stripe.
STRIPE_WEBHOOK_SECRET=
# Preços (price_…) criados no Stripe em modo de teste.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_FOUNDER_MONTHLY=

# ── Provedor de IA (opcional; padrão = gateway do Lovable) ───────────────────
# AI_PROVIDER=lovable usa LOVABLE_API_KEY (acima). Para sair do Lovable:
#   AI_PROVIDER=custom
#   AI_API_KEY=            # chave do provedor (ex.: Anthropic, OpenAI, OpenRouter)
#   AI_BASE_URL=           # API compatível com OpenAI, começando com https://
#   AI_MODEL=              # nome do modelo no provedor
# AI_MODEL também pode ser usada com "lovable" para trocar só o modelo.
AI_PROVIDER=lovable
